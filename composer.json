{
    "name": "baliguard/safety-system",
    "type": "project",
    "description": "BaliGuard - Bali Integrated Tourist Safety, Early Warning & Emergency Response System with Google Gemini AI Chatbot",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
